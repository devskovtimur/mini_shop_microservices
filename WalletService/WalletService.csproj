<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <LangVersion>16</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoMapper" Version="16.2.0" />
        <PackageReference Include="Dapper" Version="2.1.89" />
        <PackageReference Include="FluentValidation" Version="12.2.0" />
        <PackageReference Include="MassTransit" Version="9.2.4" />
        <PackageReference Include="MassTransit.RabbitMQ" Version="9.2.4" />
        <PackageReference Include="MediatR" Version="14.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.2.26504.105" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="Npgsql.DependencyInjection" Version="10.0.3" />
        <PackageReference Include="OpenTelemetry" Version="1.20.1" />
        <PackageReference Include="Serilog" Version="4.4.1-dev-02447" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
        <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.1" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.1" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Shared\Shared.csproj" />
    </ItemGroup>

</Project>
